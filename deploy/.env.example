# Galactic Conquest deployment environment.
# Copy to deploy/.env and fill in. `deploy.sh` refuses to run without a real SECRET_KEY.

# Public domain (apex). TLS is auto-provisioned by Caddy.
DOMAIN=conquest.example.com
ACME_EMAIL=ops@conquest.example.com

# Play service master secret. MUST be a long random string in production.
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-32-BYTES-HEX-00000000000000000000000000

# Postgres (inside the compose network only)
POSTGRES_PASSWORD=CHANGE-ME-db-password

# TURN (coturn) static auth secret. The play service mints per-connection creds.
# Generate: openssl rand -hex 24
TURN_SECRET=CHANGE-ME-24-BYTES-HEX-00000000000000000000

# Backups
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RCLONE_DEST=s3:gc-backups/galactic-conquest
BACKUP_INTERVAL_H=6

# Optional
METRICS_TOKEN=
GAME_DIR=../
